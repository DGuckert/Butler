# Copy this file to .env and fill in your own values.

# Absolute or relative path to the folder where downloaded songs are stored.
# Defaults to ./music if unset.
MUSIC_DIR=

# Random secret used to sign JWT auth tokens. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=changeme

# SQLite database file for users/library data.
DATABASE_URL=butler.db

# Optional: Spotify integration (playlist import). Leave blank to disable.
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must match a Redirect URI registered in your Spotify app, with
# /spotify/auth/callback appended, e.g. http://localhost:8080/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/spotify/callback

# Optional: Daily Mix generation via an LLM through OpenRouter (https://openrouter.ai)
# Leave blank to disable Daily Mix.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional: SSO login, one or more providers at once. List which ones to
# enable in OIDC_PROVIDERS (comma separated) -- each shows as its own
# button on the login screen. Every provider shares this one redirect
# URI; register the SAME url with every provider's console/dashboard.
OIDC_REDIRECT_URI=http://127.0.0.1:8080/auth/oidc/callback
OIDC_PROVIDERS=

# Google -- create an OAuth Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials, add OIDC_REDIRECT_URI
# above as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple -- needs a paid Apple Developer Program account. Create a
# Services ID at https://developer.apple.com/account/resources/identifiers
# (this is APPLE_CLIENT_ID, e.g. "com.yourdomain.butler.signin" -- NOT
# your app's Bundle ID/App ID), configure it with OIDC_REDIRECT_URI above
# as the Return URL. Then create a "Sign in with Apple" key under Keys,
# download the .p8 file once (Apple won't let you re-download it), and
# fill in the three values below from it. Apple's client_secret isn't a
# fixed value -- Butler generates a short-lived signed JWT from these on
# every login, so there's no APPLE_CLIENT_SECRET to set.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the full contents of the downloaded AuthKey_XXXXXXXXXX.p8 file,
# with real newlines replaced by \n so it fits on one env var line:
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# Any self-hosted/custom OIDC provider (Authelia, Authentik, Keycloak,
# ...) -- pick your own key (lowercase, no spaces) and add it to
# OIDC_PROVIDERS, then set these three using that key as the prefix.
# Example for a provider key of "authelia":
#   OIDC_PROVIDERS=authelia
#   AUTHELIA_ISSUER=https://auth.example.com
#   AUTHELIA_CLIENT_ID=butler
#   AUTHELIA_CLIENT_SECRET=...
#   AUTHELIA_DISPLAY_NAME=Sign in with Authelia   (optional, defaults to "Sign in with <Key>")
# Repeat with a different key to add more than one self-hosted provider.
