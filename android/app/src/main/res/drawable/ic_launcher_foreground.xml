<?xml version="1.0" encoding="utf-8"?>
<!-- Vinyl record mark in the app's actual brass/oxblood/ink palette,
     matching the vinyl motif already used in NowPlayingSheet, replacing
     the previous generic Spotify green play button left over from before
     the brass/parchment/oxblood reskin. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer disc, brass -->
    <path
        android:fillColor="#C89B3C"
        android:pathData="M54,14 a40,40 0 1,0 0.1,0 Z" />
    <!-- groove gap, ink -->
    <path
        android:fillColor="#17140F"
        android:pathData="M54,20 a34,34 0 1,0 0.1,0 Z" />
    <!-- outer groove ring, dim brass -->
    <path
        android:fillColor="#8A7638"
        android:pathData="M54,22 a32,32 0 1,0 0.1,0 Z" />
    <path
        android:fillColor="#17140F"
        android:pathData="M54,23.5 a30.5,30.5 0 1,0 0.1,0 Z" />
    <!-- label, oxblood -->
    <path
        android:fillColor="#A5453A"
        android:pathData="M54,38 a16,16 0 1,0 0.1,0 Z" />
    <!-- spindle hole, ink -->
    <path
        android:fillColor="#17140F"
        android:pathData="M54,50 a4,4 0 1,0 0.1,0 Z" />
</vector>
