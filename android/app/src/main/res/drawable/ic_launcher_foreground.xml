<?xml version="1.0" encoding="utf-8"?>
<!-- Bowtie mark, matching the redesigned web favicon/sidebar logo and
     docs/logo/butler-mark.svg. Replaces the earlier vinyl-disc-with-
     monogram foreground. Two facing wedge "wings" (brass gradient) with
     an oxblood knot at center — ties to "Butler" via formal-wear framing
     without being a literal illustration, and doubles as an abstract
     play/volume motif. Path data scaled and centered from the source
     SVG's 240x240 viewBox down to this 108dp canvas, keeping the wings
     inside the 66dp adaptive-icon safe zone (verified: bounding box is
     roughly x 25-83, y 38-70, well clear of the ~21-87 safe edges) so
     nothing clips under a circular, squircle, or rounded-square mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- left wing -->
    <path android:pathData="M 27.76,38.64 C 38.0,43.12 47.6,48.88 52.72,54.0 C 47.6,59.12 38.0,64.88 27.76,69.36 C 25.2,62.32 25.2,45.68 27.76,38.64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="25.2"
                android:startY="38.64"
                android:endX="52.72"
                android:endY="69.36"
                android:startColor="#DBAF4E"
                android:endColor="#A9812F" />
        </aapt:attr>
    </path>

    <!-- right wing -->
    <path android:pathData="M 80.24,38.64 C 70.0,43.12 60.4,48.88 55.28,54.0 C 60.4,59.12 70.0,64.88 80.24,69.36 C 82.8,62.32 82.8,45.68 80.24,38.64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="82.8"
                android:startY="38.64"
                android:endX="55.28"
                android:endY="69.36"
                android:startColor="#DBAF4E"
                android:endColor="#A9812F" />
        </aapt:attr>
    </path>

    <!-- oxblood knot -->
    <path
        android:fillColor="#A5453A"
        android:pathData="M54,49.84 a4.16,4.16 0 1,0 0.1,0 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#17140F"
        android:strokeWidth="0.48"
        android:strokeAlpha="0.4"
        android:pathData="M54,49.84 a4.16,4.16 0 1,0 0.1,0 Z" />
</vector>
